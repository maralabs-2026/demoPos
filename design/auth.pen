{
  "name": "auth",
  "description": "Autenticación - Fase 2: login, cambio de contraseña, navegación y perfil",
  "frames": [
    {
      "name": "Login - Mobile",
      "width": 360,
      "height": 640,
      "elements": [
        {
          "type": "frame",
          "name": "login-frame",
          "x": 0,
          "y": 0,
          "width": 360,
          "height": 640,
          "backgroundColor": "#ffffff",
          "children": [
            {
              "type": "text",
              "name": "titulo",
              "x": 0,
              "y": 80,
              "width": 360,
              "height": 40,
              "text": "Iniciar sesión",
              "fontSize": 32,
              "fontWeight": "600",
              "textAlign": "center",
              "foregroundColor": "#0d253d"
            },
            {
              "type": "input",
              "name": "email-input",
              "x": 20,
              "y": 150,
              "width": 320,
              "height": 52,
              "placeholder": "Correo electrónico",
              "backgroundColor": "#a8c3de",
              "borderColor": "#e3e8ee",
              "foregroundColor": "#0d253d",
              "fontSize": 16,
              "radius": 0.75
            },
            {
              "type": "input",
              "name": "password-input",
              "x": 20,
              "y": 230,
              "width": 320,
              "height": 52,
              "placeholder": "Contraseña",
              "backgroundColor": "#a8c3de",
              "borderColor": "#e3e8ee",
              "foregroundColor": "#0d253d",
              "fontSize": 16,
              "type": "password",
              "radius": 0.75
            },
            {
              "type": "button",
              "name": "ingresar-btn",
              "x": 20,
              "y": 300,
              "width": 320,
              "height": 52,
              "text": "Ingresar",
              "fontSize": 18,
              "fontWeight": "500",
              "backgroundColor": "#533afd",
              "color": "#ffffff",
              "borderRadius": 0.75,
              "hoverBackgroundColor": "#4c35e0",
              "disabledBackgroundColor": "#a0a8c0",
              "disabledColor": "#e5e5e5"
            },
            {
              "type": "text",
              "name": "error-texto",
              "x": 20,
              "y": 370,
              "width": 320,
              "height": 20,
              "text": "",
              "fontSize": 14,
              "color": "#ea2261",
              "textAlign": "center"
            }
          ]
        }
      ]
    },
